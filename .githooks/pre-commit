#!/bin/sh
set -e

# Pre-commit hook for Rasta Hisaab 2.0
# Enforces:
# 1. Source file line limit (<= 300 lines per source file)
# 2. TypeScript typecheck
# 3. ESLint
# 4. Vitest test suite

echo "========================================="
echo "  Rasta Hisaab 2.0 Pre-Commit Checks"
echo "========================================="

echo "--> [1/4] Checking source file line cap (<= 300 lines)..."
npm run test:lines

echo "--> [2/4] Checking TypeScript types..."
npm run typecheck

echo "--> [3/4] Running ESLint..."
npm run lint

if [ -n "$SKIP_TESTS" ]; then
  echo "--> [4/4] Skipping vitest run (SKIP_TESTS is set)."
else
  echo "--> [4/4] Running vitest test suites..."
  npx vitest run
fi

echo "========================================="
echo "  All pre-commit checks passed!"
echo "========================================="
exit 0
