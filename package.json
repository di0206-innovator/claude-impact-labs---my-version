{
  "name": "rastabaaz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ci": "npm run test:lines && npm run typecheck && npm run lint && npx vitest run && npm run build",
    "dev": "next dev --turbopack",
    "build": "tsx scripts/precompile-rupee.ts && tsx scripts/generate-sw.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lines": "vitest run src/test/line-limit.test.ts",
    "setup-git-hooks": "node scripts/setup-git-hooks.mjs",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "amplify:env": "tsx scripts/write-amplify-env.ts",
    "iam:policy": "tsx scripts/render-amplify-policy.ts",
    "postinstall": "node scripts/copy-maplibre-worker.mjs && node scripts/setup-git-hooks.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs"
  },
  "overrides": {
    "@mapbox/jsonlint-lines-primitives": "2.0.2",
    "postcss": "$postcss"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "maplibre-gl": "^6.11.2",
    "next": "^15.5.29",
    "pdf-lib": "1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "ux4g-web-components": "3.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.29",
    "jsdom": "26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
